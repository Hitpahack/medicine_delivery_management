{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "RepMed.Web": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "sourceMap": true,
            "optimization": false,
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/assets"
            ],
            "styles": [
              "src/assets/vendor/fonts/boxicons.css",
              "src/assets/vendor/css/core.css",
              "src/assets/vendor/css/theme-default.css",
              "src/assets/css/demo.css",
              "src/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css",
              "src/assets/vendor/css/pages/page-auth.css",
              "src/assets/vendor/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css",
              "src/assets/vendor/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css",
              "src/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css"
            ],
            "scripts": [
              "src/assets/vendor/libs/jquery/jquery.min.js",
              "src/assets/vendor/libs/popper/popper.js",
              "src/assets/vendor/js/bootstrap.js",
              "src/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js",
              "src/assets/vendor/libs/bootstrap/bootstrap.bundle.min.js",
              "src/assets/vendor/libs/datatables.net/js/jquery.dataTables.min.js",
              "src/assets/vendor/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js",
              "src/assets/vendor/libs/datatables.net-buttons/js/dataTables.buttons.min.js",
              "src/assets/vendor/libs/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js",
              "src/assets/vendor/libs/bootstrap-notify/bootstrap-notify.js",
              "src/assets/js/config.js",
              "src/assets/vendor/js/helpers.js",
              "src/assets/vendor/js/menu.js",
              "src/assets/js/appmain.js"
              
               
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "aot": true,
              "extractLicenses": true,
              "outputHashing": "all",
              "buildOptimizer": true,
              "vendorChunk": false
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "RepMed.Web:build",
            "liveReload": true,
            "watch": true
          },
          "configurations": {
            "production": {
              "buildTarget": "RepMed.Web:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "RepMed.Web:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [],
            "scripts": [],
            "assets": [
              "src/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist-server",
            "main": "src/main.ts",
            "tsConfig": "src/tsconfig.server.json",
            "sourceMap": false
          },
          "configurations": {
            "dev": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": true
            },
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          }
        }
      }
    },
    "RepMed.Web-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "RepMed.Web:serve"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": "e2e/tsconfig.e2e.json",
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "06b9e3e3-629d-41df-bb74-1afe2463c635"
  }
}